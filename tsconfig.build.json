{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src"
  },
  "include": ["src/**/*", "types/**/*.d.ts"],
  "exclude": [
    "src/**/*.test.*",
    "src/**/*.spec.*",
    "src/**/*.e2e.*",
    "src/**/demos/**",
    "src/**/fixtures/**",
    "src/**/__test/**",
    "src/**/__tests/**",
    "src/**/__tests__/**",
    "src/**/__snapshots__/**"
  ]
}
