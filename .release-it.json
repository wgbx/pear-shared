{
  "git": {
    "requireCleanWorkingDir": false,
    "commitMessage": "chore(release): ${version}"
  },
  "hooks": {
    "after:bump": ["pnpm run build"]
  },
  "github": {
    "release": true,
    "releaseBody": "Release of version ${version}",
    "tokenRef": "NPM_TOKEN",
    "host": "github.com"
  }
}
