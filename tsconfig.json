{
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@@/*": ["./.dumi/tmp/*"],
      "@bosinc/shared": ["./src"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "types/**/*.d.ts", ".dumirc.ts", "tsdown.config.mts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
