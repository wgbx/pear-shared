{
  "compilerOptions": {
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": {
      "@@/*": [
        "./.dumi/tmp/*"
      ],
      "@bosinc/shared": [
        "./src"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    ".dumirc.ts",
    ".fatherrc.ts",
    "src/**/*",
    ".dumi/theme"
  ]
}
