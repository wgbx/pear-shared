{
  "name": "@bosinc/shared",
  "version": "0.1.28",
  "description": "A react library developed with dumi",
  "repository": {
    "type": "git",
    "url": "https://github.com/bosinc/pear-shared.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "father build",
    "build:watch": "father dev",
    "dev": "dumi dev",
    "docs:build": "dumi build",
    "docs:preview": "dumi preview",
    "doctor": "father doctor",
    "lint": "npm run lint:es && npm run lint:css",
    "lint:css": "stylelint --allow-empty-input \"{src,test}/**/*.{css,less}\"",
    "lint:es": "oxlint src --deny-warnings",
    "prepare": "husky && dumi setup",
    "prepublish": "father doctor && npm run test && npm run build",
    "release": "release-it",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        2,
        "always",
        200
      ]
    }
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{css,less}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "oxlint --fix --deny-warnings",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "oxlint --fix --deny-warnings",
      "prettier --parser=typescript --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@release-it/conventional-changelog": "11.0.1",
    "@svgr/webpack": "8.1.0",
    "@types/react": "19.2.14",
    "@typescript/native": "npm:typescript@7.0.2",
    "@umijs/lint": "4.7.25",
    "dumi": "2.4.50",
    "father": "4.6.41",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.0.2",
    "release-it": "20.2.1",
    "stylelint": "14.16.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@cloudinary/url-gen": "1.21.0",
    "@emotion/react": "11.13.3",
    "@emotion/styled": "11.13.0",
    "@mingcute/react": "1.4.1",
    "@mui/material": "6.1.5",
    "ahooks": "3.8.1",
    "currency.js": "2.0.4",
    "date-fns": "2.30.0",
    "date-fns-tz": "2.0.1",
    "jotai": "2.9.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "packageManager": "pnpm@12.14.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "authors": [
    "wgbx"
  ]
}
